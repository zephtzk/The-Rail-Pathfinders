{
  "name": "commute-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-upgrades.mjs && node --check src/app.js && node --check src/engine.js && node --check src/rail-engine.js && node --check src/rail-ui.js && node --check src/multimodal-engine.js && node --check src/multimodal-ui.js && node --check src/journey-state.js && node --check src/journey-ui.js && node --check server/adapter.js && node --check server/bus-adapter.js && npm test && npm run test:import && npm run test:bus-import && python -m unittest discover -s tests -p test_walking_metadata.py && npm run build",
    "import:rail": "python scripts/import-rail.py --source data/rail/sources/lta-train-2026-09-18.zip --metadata data/rail/sources/lta-train-2026-09-18.json --rules data/rail/validation.json --output public/data/rail-network.json --manifest public/data/rail-manifest.json",
    "test:import": "python -m unittest discover -s tests -p test_import_rail.py",
    "benchmark:rail": "node scripts/benchmark-rail.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:rail-browser": "node tests/rail-browser.mjs",
    "import:bus": "python scripts/import-bus.py --source data/bus/sources/lta-bus-2026-09-18-439b6cf16c91 --rules data/bus/validation.json --output public/data/bus-network.json --manifest public/data/bus-manifest.json",
    "test:bus-import": "python -m unittest discover -s tests -p test_import_bus.py",
    "test:multimodal-browser": "node tests/multimodal-browser.mjs",
    "benchmark:multimodal": "node scripts/benchmark-multimodal.mjs",
    "test:phase4-browser": "node tests/phase4-browser.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:readiness": "node scripts/verify-readiness.mjs",
    "test:sharing-http": "node tests/sharing-http.mjs",
    "test:facilities-browser": "node tests/facilities-browser.mjs",
    "test:upgrades-browser": "node tests/upgrades-browser.mjs",
    "test:sharing-privacy-browser": "node tests/sharing-privacy-browser.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
