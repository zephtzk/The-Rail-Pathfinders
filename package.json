{
  "name": "commute-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/app.js && node --check src/engine.js && node --check src/rail-engine.js && node --check src/rail-ui.js && node --check server/adapter.js && npm test && npm run test:import && npm run build",
    "import:rail": "python scripts/import-rail.py --source data/rail/sources/lta-train-2026-09-18.zip --metadata data/rail/sources/lta-train-2026-09-18.json --rules data/rail/validation.json --output public/data/rail-network.json --manifest public/data/rail-manifest.json",
    "test:import": "python -m unittest discover -s tests -p test_import_rail.py",
    "benchmark:rail": "node scripts/benchmark-rail.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:rail-browser": "node tests/rail-browser.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
