# Canonical runtime bytes keep local and checkout builds reproducible.
src/** text eol=lf
server/** text eol=lf
public/** text=auto eol=lf
scripts/build.mjs text eol=lf
# Import provenance hashes exact bytes. Preserve these inputs/outputs on every OS.
# -text disables newline conversion; it does not disable readable text diffs.
data/rail/** -text
public/data/rail-*.json -text
scripts/import-rail.py -text
data/bus/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/facilities/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
public/data/bus-*.json -text
public/data/walking-links.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/import-bus.py -text
docs/evidence/phase3/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# This pinned rules snapshot was generated with CRLF; CR is its line ending.
data/rail/validation.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
