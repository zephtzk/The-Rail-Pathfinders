# Optional, server-only. No key is required for the labelled replay.
LTA_ACCOUNT_KEY=
# Optional ordinary OneMap API token. Server runtime only; short lived.
# Search and address routing use this via Authorization, never a browser asset.
ONEMAP_TOKEN=
# Persistent local sharing (created automatically; never commit this database).
SHARING_SQLITE_PATH=.local-data/sharing.sqlite
# Optional actual Web Push. Generate using scripts/generate-vapid.mjs into an
# ignored local file, never into client code. VAPID_PRIVATE_JWK is JSON.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=
# Explicit local delivery recorder only; leave empty for genuine push delivery.
PUSH_TRANSPORT=
# Configure this key in the hosting provider's runtime secrets.
# Never put credentials in client files or prefix with PUBLIC/VITE.
